# Non-secret project settings. Passwords are NOT stored here - they live in ../secrets/
# Strict KEY=value format, no spaces or quotes (this file is read by both make and docker compose).

# Your login: it determines the data folder (/home/LOGIN/data) and the domain
LOGIN=nor
DOMAIN_NAME=nor.42.fr

# MariaDB
MYSQL_DATABASE=wordpress
MYSQL_USER=wpuser

# WordPress (the admin username must not contain admin / Admin / administrator)
WP_TITLE=Inception
WP_ADMIN_USER=nor_boss
WP_ADMIN_EMAIL=nor_boss@nor.42.fr
WP_USER=nor_author
WP_USER_EMAIL=nor_author@nor.42.fr
